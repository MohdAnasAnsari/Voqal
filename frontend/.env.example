# ─── Backend API ──────────────────────────────────────────────────────────────
# Vite exposes variables prefixed with VITE_ to client code.
# Copy this file to .env and fill in your values.

VITE_API_URL=http://localhost:8000
VITE_API_TIMEOUT=10000

# Demo mode (uses built-in static mock data, ignores API responses)
# Set to "false" to use live API data.
VITE_DEMO_MODE=true

# WebSocket URL for real-time call updates (optional)
VITE_WS_URL=ws://localhost:8000/ws

# Environment label shown in the header
VITE_APP_ENV=development
