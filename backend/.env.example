# ─── Application ──────────────────────────────────────────────────────────────
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true
SECRET_KEY=

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://voqal_user:voqal_password@localhost:5432/voqal_db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Groq ─────────────────────────────────────────────────────────────────────
# Get a free API key from https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ─── Voice Provider ───────────────────────────────────────────────────────────
VOICE_PROVIDER=twilio
VOICE_PROVIDER_API_KEY=
VOICE_PHONE_NUMBER=+15551234567

# ─── CRM Integration ──────────────────────────────────────────────────────────
HUBSPOT_API_KEY=
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SALESFORCE_INSTANCE_URL=

# ─── Encryption ───────────────────────────────────────────────────────────────
ENCRYPTION_KEY=
